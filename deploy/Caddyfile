# Caddy serves every client domain with automatic HTTPS ("on-demand TLS"): a certificate is
# requested the first time a domain is visited, but only if the app confirms the domain belongs
# to a client (or is the console host). Point a client's domain (A/AAAA or CNAME) at this server
# and add it in the console — nothing to change here.
{
	on_demand_tls {
		ask http://app:3000/_internal/domain-check
	}
}

https:// {
	tls {
		on_demand
	}
	encode zstd gzip

	# Long-lived caching for hashed build assets and uploaded media.
	@immutable path /_app/immutable/* /media/uploads/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	request_body {
		max_size 10MB
	}

	# Caddy passes the original Host and X-Forwarded-Proto/For headers to the app.
	reverse_proxy app:3000
}
