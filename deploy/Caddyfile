# Caddy obtains and renews HTTPS certificates automatically for {$DOMAIN}.
{$DOMAIN} {
	encode zstd gzip

	# Long-lived caching for hashed build assets and uploaded media.
	@immutable path /_app/immutable/* /media/uploads/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	request_body {
		max_size 10MB
	}

	reverse_proxy app:3000
}

# Redirect www → apex (remove if you prefer the opposite).
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
