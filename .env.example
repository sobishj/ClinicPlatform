# ─────────────────────────────────────────────────────────────────────────────
# Clinic platform — environment variables
# Copy to .env for local development or a server install.
# On Cloudflare: plain values go in wrangler.toml [vars]; secrets via
#   npx wrangler secret put NAME
# Values set here override the matching settings saved in each client's admin panel.
# ─────────────────────────────────────────────────────────────────────────────

# Build target (read at build time): node | cloudflare. Default: node
DEPLOY_TARGET=node

# ── Platform ──
# Host name of the console (super admin). Client sites never answer on it.
# Default: console.localhost (local development)
# PLATFORM_ADMIN_HOST=console.example.com
#
# Do NOT set ORIGIN: one server answers for many client domains, and each request's Host
# header picks the client. Behind a proxy (Caddy, nginx, a cloud load balancer) set instead:
# PROTOCOL_HEADER=x-forwarded-proto
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# ── Databases (node target) ──
# Platform database (clients, addresses, console logins). Default: ./data/platform.db
# PLATFORM_DATABASE_PATH=./data/platform.db
# One folder per client: <id>/site.db and <id>/uploads/. Default: ./data/tenants
# TENANT_DATA_DIR=./data/tenants

# ── File storage (node target) ──
# local (default) | s3
# STORAGE_DRIVER=local
# Root for uploads, one sub-folder per client. Default: TENANT_DATA_DIR
# UPLOAD_DIR=./data/tenants
# S3-compatible bucket (AWS S3, MinIO, Backblaze B2…); each client gets the prefix tenants/<id>/.
# On Cloudflare, uploads are stored in each client's own D1 database instead.
# S3_ENDPOINT=https://s3.eu-west-1.amazonaws.com
# S3_REGION=auto
# S3_BUCKET=clinic-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# ── Email (optional; the site works without it) ──
# EMAIL_PROVIDER=none          # none | resend | smtp (smtp: node target only)
# EMAIL_FROM="Clinic Name <no-reply@example.com>"
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# ── Cloudflare Turnstile (spam protection on booking/contact forms) ──
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Operations ──
# Bearer token for POST https://<console host>/console/cron (webhook retries, cleanup for all clients)
# CRON_SECRET=
# If set, the first-run /console/setup screen asks for this token
# SETUP_TOKEN=
