# ─────────────────────────────────────────────────────────────────────────────
# Clinic website — environment variables
# Every variable is OPTIONAL. Copy to .env for local development.
# On Cloudflare: plain values go in wrangler.toml [vars]; secrets via
#   npx wrangler secret put NAME
# Values set here override the matching settings saved in the admin panel.
# ─────────────────────────────────────────────────────────────────────────────

# Build target (read at build time): node | cloudflare. Default: node
DEPLOY_TARGET=node

# Public site URL. Required by adapter-node behind a proxy for correct form CSRF checks.
# ORIGIN=https://www.example.com

# ── Database (node target) ──
# SQLite file. Default: ./data/clinic.db
# DATABASE_PATH=./data/clinic.db
# Folder with Drizzle migrations (applied automatically on start). Default: ./drizzle
# MIGRATIONS_DIR=./drizzle

# ── File storage (node target) ──
# local (default) | s3
# STORAGE_DRIVER=local
# UPLOAD_DIR=./data/uploads
# S3-compatible bucket (AWS S3, Cloudflare R2 S3 API, MinIO, Backblaze B2…)
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=clinic-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Serve media from a public bucket/custom domain instead of /media (optional)
# MEDIA_PUBLIC_BASE_URL=https://media.example.com

# ── Email (optional; the site works without it) ──
# EMAIL_PROVIDER=none          # none | resend | smtp (smtp: node target only)
# EMAIL_FROM="Clinic Name <no-reply@example.com>"
# RESEND_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false

# ── Cloudflare Turnstile (spam protection on booking/contact forms) ──
# Test keys that always pass: site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# ── Operations ──
# Bearer token for POST /api/internal/cron (webhook retries, cleanup)
# CRON_SECRET=
# If set, the first-run /admin/setup screen asks for this token
# SETUP_TOKEN=
