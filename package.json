{
	"name": "clinic-site",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*",
		"#target": "./src/lib/server/target/node.ts"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:node": "cross-env DEPLOY_TARGET=node vite build",
		"build:cf": "cross-env DEPLOY_TARGET=cloudflare vite build",
		"preview": "vite preview",
		"start": "node build",
		"preview:cf": "npm run build:cf && wrangler dev",
		"deploy:cf": "npm run build:cf && wrangler d1 migrations apply clinic-db --remote && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/migrate.ts",
		"db:migrate:d1:local": "wrangler d1 migrations apply clinic-db --local",
		"db:migrate:d1": "wrangler d1 migrations apply clinic-db --remote",
		"seed": "tsx scripts/seed.ts",
		"create-admin": "tsx scripts/create-admin.ts",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"migrate:data": "tsx scripts/migrate-data.ts",
		"backup": "sh deploy/backup.sh once"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@cloudflare/workers-types": "^5.20261113.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/adapter-node": "^6.0.2",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"cross-env": "^10.1.0",
		"drizzle-kit": "^0.31.11",
		"lighthouse": "^13.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^4.1.8",
		"wrangler": "^4.161.0"
	},
	"dependencies": {
		"aws4fetch": "^1.0.20",
		"better-sqlite3": "^13.1.1",
		"drizzle-orm": "^0.45.4",
		"lucide": "^1.72.0",
		"nodemailer": "^10.5.0",
		"tsx": "^4.23.15",
		"xss": "^1.0.17",
		"zod": "^4.6.7"
	},
	"engines": {
		"node": ">=20.19"
	}
}
